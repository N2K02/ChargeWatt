<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_bg_transparent"
    android:paddingStart="5dp"
    android:paddingEnd="5dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="18dp">
        <ImageView
            android:id="@+id/widget_charge_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="Charging state"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_ac" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_temperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="27°"
                android:textColor="#F7F7F9"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:textSize="9sp"
                android:includeFontPadding="false"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="82%"
                android:textColor="#F7F7F9"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:textSize="9sp"
                android:includeFontPadding="false"
                android:singleLine="true" />
        </LinearLayout>
    </RelativeLayout>

    <TextView
        android:id="@+id/widget_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="−1.33A"
        android:textColor="#FFB443"
        android:fontFamily="sans-serif-condensed"
        android:textStyle="bold"
        android:textSize="14sp"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:ellipsize="end"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="9sp"
        android:autoSizeMaxTextSize="14sp"
        android:autoSizeStepGranularity="1sp" />

    <TextView
        android:id="@+id/widget_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="−5.28W"
        android:textColor="#F7F7F9"
        android:fontFamily="sans-serif-condensed"
        android:textStyle="bold"
        android:textSize="14sp"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:ellipsize="end"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="9sp"
        android:autoSizeMaxTextSize="14sp"
        android:autoSizeStepGranularity="1sp" />

    <TextView
        android:id="@+id/widget_voltage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="4.34V"
        android:textColor="#9BD6DE"
        android:fontFamily="sans-serif-condensed"
        android:textStyle="bold"
        android:textSize="14sp"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:ellipsize="end"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="9sp"
        android:autoSizeMaxTextSize="14sp"
        android:autoSizeStepGranularity="1sp" />
</LinearLayout>
