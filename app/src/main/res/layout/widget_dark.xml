<?xml version="1.0" encoding="utf-8"?>
<!-- 1x1 battery-side power widget. No blur engine, bitmaps or animations. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_bg_dark"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Frosted-glass header: circular activity badge + level pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/widget_status_circle"
            android:gravity="center"
            android:text="↓"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#50F0A2"
            android:includeFontPadding="false"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="1dp"/>

        <TextView
            android:id="@+id/widget_level"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:minWidth="33dp"
            android:gravity="center"
            android:background="@drawable/widget_chip_dark"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="20%"
            android:textColor="#FAFAFF"
            android:fontFamily="sans-serif-condensed"
            android:textStyle="bold"
            android:textSize="12sp"
            android:includeFontPadding="false"/>
    </LinearLayout>

    <!-- Large single-line power/current headline; auto-shrinks on narrow 1x1 grids -->
    <TextView
        android:id="@+id/widget_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="20dp"
        android:gravity="center"
        android:text="−1.33A"
        android:textColor="#FFB443"
        android:fontFamily="sans-serif-condensed"
        android:textStyle="bold"
        android:textSize="18sp"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:ellipsize="end"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeMaxTextSize="18sp"
        android:autoSizeStepGranularity="1sp"/>

    <TextView
        android:id="@+id/widget_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="1dp"
        android:text="−5.28W"
        android:textColor="#F7F7F9"
        android:fontFamily="sans-serif-condensed"
        android:textSize="12sp"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:ellipsize="end"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="12sp"
        android:autoSizeStepGranularity="1sp"/>

    <TextView
        android:id="@+id/widget_voltage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="1dp"
        android:text="3.67 V"
        android:textColor="#9BD6DE"
        android:fontFamily="sans-serif-condensed"
        android:textSize="11sp"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:ellipsize="end"/>
</LinearLayout>
